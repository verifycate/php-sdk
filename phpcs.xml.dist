<?xml version="1.0"?>
<ruleset name="Verifycate PHP SDK">
	<description>PSR-12 coding standard for the Verifycate PHP SDK.</description>

	<file>src</file>
	<file>tests</file>
	<file>scripts</file>

	<arg value="sp"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>

	<rule ref="PSR12"/>
</ruleset>
